# Compose stack env — dev defaults, fill secrets before `docker compose up`.
DATABASE_URL=postgresql://cortex:cortex@postgres:5432/cortex
REDIS_URL=redis://redis:6379

ARTIFACT_BACKEND=s3
S3_BUCKET=cortex-artifacts
S3_ENDPOINT_URL=http://s3:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=us-east-1

# Required — no defaults.
OPENAI_API_KEY=
VAULT_FERNET_KEY=

OPENAI_MODEL=gpt-5-mini
BROWSER_HEADLESS=true
# Chromium inside unprivileged containers can't sandbox.
BROWSER_CHROMIUM_SANDBOX=false
REQUIRE_API_KEY=false
API_KEYS=
TASK_TIMEOUT_S=600
STEP_TIMEOUT_S=180
WORKER_CONCURRENCY=2
SESSION_OPEN_TIMEOUT_S=600
SESSION_TTL_S=604800
SESSION_QUEUE_NAME=arq:queue:sessions
HUMAN_NOTIFY_URL=
