# Cortex-OS configuration
# Copy to .env and fill in real values. Never commit .env.

# Required — LLM for the browser-use engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Queue + storage
REDIS_URL=redis://localhost:6379
# sqlite:///./cortex.db (dev default) or postgresql://user:pass@host:5432/cortex
DATABASE_URL=sqlite:///./cortex.db
ARTIFACTS_DIR=./artifacts

# Browser
BROWSER_HEADLESS=true
BROWSER_PROFILES_DIR=./profiles

# Limits
MAX_STEPS=100
TASK_TIMEOUT_S=600
STEP_TIMEOUT_S=180
WORKER_CONCURRENCY=2

# Auth (P1) — set REQUIRE_API_KEY=true + comma-separated keys to gate the API
REQUIRE_API_KEY=false
API_KEYS=

# Credential vault (P1) — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_FERNET_KEY=

# Human escalation webhook (P2)
HUMAN_NOTIFY_URL=

# Max duration a headed login browser stays open via /sessions/{id}/open
SESSION_OPEN_TIMEOUT_S=600
# New sessions expire after this many seconds (default 7 days)
SESSION_TTL_S=604800
# Dedicated arq queue name for headed-login jobs (served by SessionWorkerSettings)
SESSION_QUEUE_NAME=arq:queue:sessions

# Pluggable backends — registry keys, not URLs
ARTIFACT_BACKEND=fs       # fs now; s3 later
SECRETS_BACKEND=fernet    # fernet now; kms later
QUEUE_BACKEND=arq         # arq (Redis)
